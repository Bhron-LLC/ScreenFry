// The setup library's Worker (docs/SETUP_LIBRARY.md). The top level is for local
// development and tests (`npm run dev`, `npm test`); `--env staging` and `--env production`
// are the real deployments. Bindings aren't inherited by environments, so each repeats them.
// database_id is left out: Wrangler creates the database on the first deploy and fills it in.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenfry-library",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Deletes daily counts older than two days.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "screenfry-library-dev", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "READS", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": { "PUBLISH_DAILY_CAP": "1000", "SEARCH_CACHE_SECONDS": "60" },
  "env": {
    "staging": {
      "name": "screenfry-library-staging",
      "d1_databases": [{ "binding": "DB", "database_name": "screenfry-library-staging", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "READS", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "WRITES", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": { "PUBLISH_DAILY_CAP": "1000", "SEARCH_CACHE_SECONDS": "60" }
    },
    "production": {
      "name": "screenfry-library",
      "d1_databases": [{ "binding": "DB", "database_name": "screenfry-library", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "READS", "namespace_id": "3001", "simple": { "limit": 60, "period": 60 } },
        { "name": "WRITES", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": { "PUBLISH_DAILY_CAP": "1000", "SEARCH_CACHE_SECONDS": "60" }
    }
  }
}
